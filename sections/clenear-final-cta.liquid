{{ 'clenear-home-v2.css' | asset_url | stylesheet_tag }}
{{ 'clenear-pages.css' | asset_url | stylesheet_tag }}

{%- assign map_query = section.settings.city | default: 'Av. Cel. Manoel Nunes, 489 - Laranjeiras Velha, Serra - ES, 29162-155' -%}
{%- assign encoded_map_query = map_query | url_encode -%}
{%- assign map_url = section.settings.map_url -%}
{%- if map_url == blank -%}
  {%- assign map_url = 'https://www.google.com/maps/search/?api=1&query=' | append: encoded_map_query -%}
{%- endif -%}

<section class="cl-final-cta cl-dark" id="contato">
  <div class="cl-final-cta__bg" aria-hidden="true"></div>
  <div class="cl-wrap cl-final-cta__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="cl-label" style="justify-content:center;">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <h2 class="cl-h2">{{ section.settings.heading }}</h2>
    <p class="cl-lead">{{ section.settings.subtext }}</p>

    <div class="cl-btn-row">
      {%- if section.settings.cta_wa_label != blank -%}
        <a href="{{ section.settings.cta_wa_url }}" class="cl-btn cl-btn--whatsapp" target="_blank" rel="noopener">
          {{ section.settings.cta_wa_label | escape }}
        </a>
      {%- endif -%}

      {%- if section.settings.cta2_label != blank -%}
        <a href="{{ section.settings.cta2_url }}" class="cl-btn cl-btn--white" {% if section.settings.cta2_url contains 'http' %}target="_blank" rel="noopener"{% endif %}>
          {{ section.settings.cta2_label | escape }}
        </a>
      {%- endif -%}

      {%- if section.settings.cta3_label != blank -%}
        <a href="{{ section.settings.cta3_url }}" class="cl-btn cl-btn--ghost" {% if section.settings.cta3_url contains 'http' %}target="_blank" rel="noopener"{% endif %}>
          {{ section.settings.cta3_label | escape }}
        </a>
      {%- endif -%}
    </div>

    <div class="cl-final-cta__channels">
      {%- if section.settings.phone != blank -%}
        <div class="cl-final-cta__channel">
          <span>Telefone</span>
          <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ section.settings.phone }}</a>
        </div>
      {%- endif -%}

      {%- if section.settings.email != blank -%}
        <div class="cl-final-cta__channel">
          <span>E-mail</span>
          <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
        </div>
      {%- endif -%}

      {%- if section.settings.city != blank -%}
        <div class="cl-final-cta__channel cl-final-cta__channel--location">
          <span>Localização</span>
          <a href="{{ map_url }}" target="_blank" rel="noopener">{{ section.settings.city }}</a>
        </div>
      {%- endif -%}
    </div>

    {%- unless section.settings.show_map == false or section.settings.city == blank -%}
      <div class="cl-final-cta__map">
        <iframe
          title="Mapa da localização da Clenear"
          src="https://maps.google.com/maps?q={{ encoded_map_query }}&output=embed"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>
    {%- endunless -%}
  </div>
</section>

{% schema %}
{
  "name": "Clenear: CTA Final",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pronto para começar?" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Fale com a equipe Clenear" },
    { "type": "textarea", "id": "subtext", "label": "Subtexto", "default": "Precisa de orçamento, quer revender ou tem dúvida técnica?" },
    { "type": "text", "id": "cta_wa_label", "label": "WhatsApp", "default": "Chamar no WhatsApp" },
    { "type": "url", "id": "cta_wa_url", "label": "WhatsApp link" },
    { "type": "text", "id": "cta2_label", "label": "CTA 2", "default": "Solicitar orçamento" },
    { "type": "url", "id": "cta2_url", "label": "CTA 2 link" },
    { "type": "text", "id": "cta3_label", "label": "CTA 3", "default": "Quero ser revendedor" },
    { "type": "url", "id": "cta3_url", "label": "CTA 3 link" },
    { "type": "text", "id": "phone", "label": "Telefone", "default": "(27) 3228-0140" },
    { "type": "text", "id": "email", "label": "E-mail" },
    { "type": "text", "id": "city", "label": "Cidade", "default": "Av. Cel. Manoel Nunes, 489 - Laranjeiras Velha, Serra - ES, 29162-155" },
    { "type": "url", "id": "map_url", "label": "Link do mapa" },
    { "type": "checkbox", "id": "show_map", "label": "Mostrar mapa", "default": true }
  ],
  "presets": [{ "name": "Clenear CTA Final" }]
}
{% endschema %}
